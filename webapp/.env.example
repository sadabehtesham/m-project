# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to GitHub.

SECRET_KEY=change-this-to-a-random-secret-key

# PostgreSQL connection string format:
# postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://models_user:Sadab123@localhost:5432/models_db

# Gmail SMTP (for sending OTP verification emails)
# See README.md "Email setup" section for how to generate an App Password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_16_char_app_password_here
MAIL_DEFAULT_SENDER=your_gmail_address@gmail.com
